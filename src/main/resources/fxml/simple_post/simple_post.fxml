            <Font name="Arial Black" size="17.0" />
         </font>
      </Label>
      <TextField fx:id="commentBox" layoutX="110.0" layoutY="424.0" prefHeight="25.0" prefWidth="511.0" promptText="Write Comment Here" />
      <ScrollPane layoutX="8.0" layoutY="463.0" prefHeight="150.0" prefWidth="716.0">
         <content>
            <VBox fx:id="comments" spacing="10.0" />
         </content>
      </ScrollPane>
   </children>
</Pane>
