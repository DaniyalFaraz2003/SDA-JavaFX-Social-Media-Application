<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane maxWidth="-Infinity" prefWidth="710.0" stylesheets="@../../css/post.css" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.sdaprojectsocialmediaapp.controllers.engagements.AnswerCont">
   <children>
      <Label layoutX="9.0" layoutY="8.0" styleClass="postTitle" text="Answer:" />
      <Label fx:id="answer" layoutX="8.0" layoutY="35.0" styleClass="postDesc" stylesheets="@../../css/post.css" text="This is a Answer" />
      <ToggleButton fx:id="likeBtn" layoutX="641.0" layoutY="81.0" mnemonicParsing="false" onMouseClicked="#handleLike" styleClass="postButton" text="Like" />
      <Label fx:id="likeCount" layoutX="696.0" layoutY="83.0" styleClass="postTitle" text="0" />
      <Label fx:id="answerAuthor" layoutX="194.0" layoutY="96.0" styleClass="postMeta" text="By: Hammad Ali" />
      <Label fx:id="answerTimestamp" layoutX="9.0" layoutY="96.0" styleClass="postMeta" text="Posted On: 2024-11-12 08:35:12" />
      <Button fx:id="markCorrect" layoutX="505.0" layoutY="82.0" mnemonicParsing="false" styleClass="postButton" text="Mark As Correct" />
      <ImageView fx:id="tickSign" fitHeight="30.0" fitWidth="30.0" layoutX="296.0" layoutY="82.0" pickOnBounds="true" preserveRatio="true" />
   </children>
   <padding>
      <Insets bottom="10.0" />
   </padding>
</AnchorPane>
